{
    "printWidth": 180,
    "singleQuote": true,
    "semi": true,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "*.html",
            "options": {
                "parser": "angular",
                "htmlWhitespaceSensitivity": "ignore"
            }
        },
        {
            "files": "*.css",
            "options": {
                "parser": "css"
            }
        }
    ]
}